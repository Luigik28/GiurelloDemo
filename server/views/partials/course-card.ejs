<article class="card course-card reveal" data-category="<%= c.category %>" data-search="<%= (c.title + ' ' + c.summary + ' ' + c.subjects.join(' ')).toLowerCase() %>">
  <div class="course-card__top">
    <span class="chip"><%= categoryLabel(c.category) %></span>
    <% if (c.badge) { %><span class="badge"><%= c.badge %></span><% } %>
  </div>
  <h3><a href="/concorsi/<%= c.slug %>" class="stretched"><%= c.title %></a></h3>
  <p><%= c.summary %></p>
  <div class="course-card__foot">
    <span class="price"><small>da</small> <%= c.price %> €</span>
    <span class="link-arrow">Scopri <%- include('icon', { name: 'arrow' }) %></span>
  </div>
</article>
