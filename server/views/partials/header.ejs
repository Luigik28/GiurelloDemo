<% if (site.announcement) { %>
<div class="topbar"><%= site.announcement.text %><a href="<%= site.announcement.href %>"><%= site.announcement.cta %> →</a></div>
<% } %>
<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="brand" href="/" aria-label="Giurello – home"><img src="/img/logo.webp" alt="Giurello" width="104" height="44"></a>
    <nav class="nav__links" id="menu" aria-label="Principale">
      <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Home</a>
      <div class="nav__drop <%= currentPath.startsWith('/concorsi') ? 'is-active' : '' %>" data-drop>
        <button type="button" aria-expanded="false" aria-haspopup="true">Concorsi <%- include('icon', { name: 'chevron' }) %></button>
        <div class="nav__menu">
          <% site.navAreas.forEach(function (a) { %>
            <a href="/concorsi/<%= a.id %>"><%- include('icon', { name: a.icon }) %> <%= a.label %></a>
          <% }) %>
          <hr>
          <a href="/concorsi"><%- include('icon', { name: 'search' }) %> Tutti i concorsi</a>
        </div>
      </div>
      <% site.nav.forEach(function (item) { const on = currentPath === item.href || currentPath.startsWith(item.href + '/'); %>
        <a href="<%= item.href %>" class="<%= on ? 'is-active' : '' %>" <%- on ? 'aria-current="page"' : '' %>><%= item.label %></a>
      <% }) %>
    </nav>
    <div class="nav__tools">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Cambia tema"><%- include('icon', { name: 'moon', cls: 'i-moon' }) %><%- include('icon', { name: 'sun', cls: 'i-sun' }) %></button>
      <a class="icon-btn <%= account ? 'is-logged' : '' %>" href="<%= account ? site.accountUrl : site.loginUrl %>" aria-label="<%= account ? 'Area studenti' : 'Accedi' %>" title="<%= account ? 'Area studenti: ' + account.email : 'Accedi' %>"><%- include('icon', { name: 'user' }) %></a>
      <a class="icon-btn cart-btn" href="<%= site.cartUrl %>" aria-label="Carrello<%= cartCount ? ', ' + cartCount + ' prodotti' : '' %>" title="Carrello"><%- include('icon', { name: 'cart' }) %><% if (cartCount) { %><span class="cart-btn__n"><%= cartCount %></span><% } %></a>
      <button class="icon-btn nav__burger" type="button" data-menu-toggle aria-controls="menu" aria-expanded="false" aria-label="Apri menu"><%- include('icon', { name: 'menu' }) %></button>
    </div>
  </div>
</header>
<main id="main">
