</main>
<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/img/logo.webp" alt="Giurello" width="123" height="52">
      <p><%= site.tagline %>.</p>
      <div class="footer__social">
        <% site.social.forEach(function (s) { %>
          <a class="icon-btn" href="<%= s.url %>" target="_blank" rel="noopener" aria-label="<%= s.name %>"><%- include('icon', { name: s.icon }) %></a>
        <% }) %>
      </div>
    </div>
    <div>
      <h3>Formazione</h3>
      <ul>
        <li><a href="/concorsi">Concorsi</a></li>
        <li><a href="/dispense">Dispense</a></li>
        <li><a href="/podcast-e-altro">Podcast e altro</a></li>
        <li><a href="/avvocato">Esame d'avvocato</a></li>
        <li><a href="/galletto">Galletto AI</a></li>
      </ul>
    </div>
    <div>
      <h3>Giurello</h3>
      <ul>
        <li><a href="/chi-siamo">Chi siamo</a></li>
        <li><a href="/help">Help e contatti</a></li>
        <li><a href="<%= site.legal.terms %>">Condizioni generali</a></li>
        <li><a href="<%= site.legal.privacy %>" target="_blank" rel="noopener">Privacy policy</a></li>
        <li><a href="<%= site.legal.cookie %>" target="_blank" rel="noopener">Cookie policy</a></li>
      </ul>
    </div>
    <div>
      <h3>Contatti</h3>
      <address>
        <%= site.company.legalName %><br>
        <%= site.company.address %><br>
        <%= site.company.zip %> <%= site.company.city %> (<%= site.company.province %>)<br>
        <a href="mailto:<%= site.company.email %>"><%= site.company.email %></a>
      </address>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© <%= year %> <%= site.company.legalName %> · P.IVA <%= site.company.vat %> · Tutti i diritti riservati</span>
    <a href="<%= site.accountUrl %>">Area studenti</a>
  </div>
</footer>
<%- include('overlays') %>
<div class="cookie" data-cookie hidden>
  <p>Usiamo solo cookie tecnici necessari al funzionamento del sito. <a href="<%= site.legal.cookie %>" target="_blank" rel="noopener">Cookie policy</a></p>
  <button type="button" class="btn btn--primary btn--sm" data-cookie-ok>Ho capito</button>
</div>
</body>
</html>
