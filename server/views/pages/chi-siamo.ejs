<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/page-hero', { eyebrow: site.about.subtitle, heading: 'Il team <span class="hl">Giurello</span>', lead: site.about.intro }) %>

<section class="section">
  <div class="container">
    <div class="section__head reveal"><span class="eyebrow">Le nostre aree</span><h2>Chi c’è dietro Giurello</h2></div>
    <div class="features">
      <% site.about.teams.forEach(function (t) { %><article class="card feature reveal"><span class="icon-tile"><%- include('../partials/icon', { name: t.icon }) %></span><h3><%= t.title %></h3><p><%= t.text %></p></article><% }) %>
    </div>
  </div>
</section>

<section class="section section--purple">
  <div class="container split">
    <div class="reveal">
      <span class="eyebrow"><%= site.about.milestoneTitle %></span>
      <h2>Il nostro più grande traguardo?</h2>
      <p><%= site.about.milestone %></p>
    </div>
    <div class="reveal center">
      <img src="/img/logo-cerchio.webp" alt="" width="220" height="220" loading="lazy" class="about-logo">
      <p class="about-count"><strong data-count="10000" data-suffix="+">10.000+</strong><span>successi di studenti</span></p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div class="split__img reveal"><img src="/img/tesi.jpg" alt="Studenti durante una lezione" loading="lazy"></div>
    <div class="reveal">
      <span class="eyebrow">Community</span>
      <h2><%= site.about.communityTitle %></h2>
      <p class="lead"><%= site.about.community %></p>
      <div class="hero__actions"><a class="btn btn--primary" href="/concorsi">Inizia ora</a><a class="btn btn--ghost" href="<%= site.social[0].url %>" target="_blank" rel="noopener">Seguici su Instagram</a></div>
    </div>
  </div>
</section>

<section class="section section--cream">
  <div class="container">
    <div class="card company reveal">
      <div><span class="eyebrow">Sede</span><h2><%= site.company.legalName %></h2><p class="lead"><%= site.company.address %>, <%= site.company.zip %> <%= site.company.city %> (<%= site.company.province %>) · P.IVA <%= site.company.vat %></p></div>
      <a href="/help#contatti" class="btn btn--primary btn--lg">Contattaci</a>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
