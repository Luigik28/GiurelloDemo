<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/page-hero', { eyebrow: 'Area universitaria', heading: 'Studia Giurisprudenza <span class="hl">con metodo</span>', lead: 'Metodo di studio, organizzazione della sessione, tesi di laurea e orientamento post laurea: tutto quello che serve per arrivare fino in fondo, un passo alla volta.' }) %>
<%- include('../partials/trust') %>

<section class="section">
  <div class="container">
    <div class="section__head reveal"><span class="eyebrow">I nostri corsi</span><h2>Dal primo esame al post laurea</h2></div>
    <div class="grid grid--4">
      <% featured.forEach(function (f) { %>
        <article class="pcard reveal">
          <div class="pcard__img"><img src="<%= f.img %>" alt="" loading="lazy"></div>
          <div class="pcard__body">
            <span class="tag"><%= f.p.typeLabel %></span>
            <h3><a class="stretched" href="/prodotto/<%= f.p.slug %>"><%= f.p.name %></a></h3>
            <p><%= f.p.description %></p>
            <div class="pcard__foot"><span class="price"><%= f.p.price %></span><span class="link-arrow">Scopri <%- include('../partials/icon', { name: 'arrow' }) %></span></div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section section--cream">
  <div class="container">
    <div class="section__head section__head--row reveal"><div><span class="eyebrow">Area universitaria</span><h2>Tutti i materiali per l’università</h2></div><a class="btn btn--ghost" href="/concorsi/area-universitaria">Apri nel catalogo</a></div>
    <div class="grid"><% products.slice(0, 9).forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %></div>
  </div>
</section>
<%- include('../partials/cta-tutor') %>
<%- include('../partials/footer') %>
