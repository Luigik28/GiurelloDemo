<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/page-hero', { eyebrow: 'Galletto · la tua IA personale per lo studio', heading: 'Basta studiare <span class="hl">nel buio!</span>', lead: 'Preparati come se fossi già all’esame, con una guida che ti allena e ti corregge. Migliora ogni giorno, supera ogni ostacolo.' }) %>

<section class="section">
  <div class="container split">
    <div class="reveal">
      <span class="eyebrow">Scopri Galletto</span>
      <h2>Supera il tuo esame con metodo e sicurezza</h2>
      <p class="lead"><%= site.galletto.intro %></p>
      <ul class="checklist"><% site.galletto.features.forEach(function (f) { %><li><%- include('../partials/icon', { name: 'check' }) %><%= f.text %></li><% }) %></ul>
      <p class="muted"><%= site.galletto.about %></p>
    </div>
    <div class="card chat reveal" data-chat>
      <div class="chat__head">
        <img src="/img/logo-cerchio.webp" alt="" width="44" height="44">
        <div><strong>Galletto</strong><small><span class="dot"></span> online · demo</small></div>
      </div>
      <div class="chat__log" data-chat-log aria-live="polite">
        <div class="bubble bubble--bot">Chicchirichì! Sono Galletto. Dimmi per quale concorso o esame ti prepari, oppure chiedimi un consiglio sul metodo di studio.</div>
      </div>
      <div class="chat__suggest" data-chat-suggest>
        <button type="button" class="chip">Come mi organizzo?</button>
        <button type="button" class="chip">Concorso Agenzia delle Entrate</button>
        <button type="button" class="chip">Concorso INPS</button>
        <button type="button" class="chip">Aiuto con la tesi</button>
      </div>
      <form class="chat__form" data-chat-form>
        <label class="sr-only" for="chat-input">Messaggio</label>
        <input id="chat-input" name="message" autocomplete="off" maxlength="500" placeholder="Scrivi a Galletto…" required>
        <button class="btn btn--primary btn--icon" aria-label="Invia"><%- include('../partials/icon', { name: 'send' }) %></button>
      </form>
    </div>
  </div>
</section>

<section class="section section--cream" id="piano">
  <div class="container split split--top">
    <div class="reveal">
      <span class="eyebrow">Piano di studio</span>
      <h2>Il tuo piano, <span class="hl">in 10 secondi</span></h2>
      <p class="lead">Scegli il concorso e la data della prova: Galletto calcola le batterie di quiz settimana per settimana, con ripasso e simulazioni finali, come nei simulatori Giurello.</p>
    </div>
    <form class="card form reveal" data-plan-form>
      <label>Concorso
        <select name="course" required>
          <% courseOptions.forEach(function (c) { %><option value="<%= c.slug %>" <%= selected === c.slug ? 'selected' : '' %>><%= c.title %></option><% }) %>
        </select>
      </label>
      <div class="form__row">
        <label>Data della prova <input type="date" name="examDate" required data-min-today></label>
        <label>Giorni di studio a settimana <input type="number" name="daysPerWeek" min="1" max="7" value="5"></label>
      </div>
      <button class="btn btn--primary btn--block">Genera il piano</button>
      <p class="form__err" data-plan-error hidden></p>
    </form>
  </div>
  <div class="container"><div class="plan-out" data-plan-out hidden></div></div>
</section>

<section class="section">
  <div class="container">
    <div class="section__head center reveal"><span class="eyebrow">Piani di abbonamento</span><h2>Scegli il tuo piano</h2></div>
    <div class="offers">
      <% site.galletto.plans.forEach(function (pl) { %>
        <article class="offer reveal <%= pl.featured ? 'offer--featured' : '' %>">
          <h3><%= pl.name %></h3>
          <div class="offer__price"><%= pl.price %></div>
          <p class="offer__note"><%= pl.period %></p>
          <ul><% pl.items.forEach(function (it) { %><li class="<%= it[1] ? '' : 'is-off' %>"><%- include('../partials/icon', { name: it[1] ? 'check' : 'x' }) %><%= it[0] %></li><% }) %></ul>
          <a href="/help#contatti" class="btn <%= pl.featured ? 'btn--yellow' : 'btn--primary' %>"><%= pl.cta %></a>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<%- include('../partials/cta-tutor') %>
<%- include('../partials/footer') %>
