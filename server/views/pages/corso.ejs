<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="page-hero page-hero--course">
  <div class="container course-hero">
    <div>
      <nav class="crumbs" aria-label="Percorso"><a href="/concorsi">Concorsi</a> / <a href="/concorsi?categoria=<%= course.category %>"><%= categoryLabel(course.category) %></a></nav>
      <h1><%= course.title %></h1>
      <p class="lead"><%= course.description %></p>
      <ul class="tags"><% course.highlights.forEach(function (h) { %><li><%- include('../partials/icon', { name: 'check' }) %> <%= h %></li><% }) %></ul>
    </div>
    <aside class="card buy-card">
      <% if (course.badge) { %><span class="badge"><%= course.badge %></span><% } %>
      <span class="buy-card__label">Prezzo definitivo</span>
      <div class="buy-card__price"><%= course.price %> €</div>
      <p class="muted">Prezzo di lancio scontato nelle prime 24 ore dalla pubblicazione.</p>
      <a class="btn btn--primary btn--lg btn--block" href="<%= buyUrl %>" target="_blank" rel="noopener">Acquista il simulatore</a>
      <a class="btn btn--ghost btn--block" href="/galletto?corso=<%= course.slug %>#piano">Crea il piano con Galletto</a>
      <ul class="buy-card__list">
        <li><%- include('../partials/icon', { name: 'shield' }) %> Accesso da ogni dispositivo</li>
        <li><%- include('../partials/icon', { name: 'calendar' }) %> Piano di studio integrato</li>
        <li><%- include('../partials/icon', { name: 'target' }) %> Quiz su tutte le materie del bando</li>
      </ul>
    </aside>
  </div>
</section>

<section class="section section--flush">
  <div class="container">
    <div class="section__head reveal"><span class="eyebrow">Programma</span><h2>Le materie del simulatore</h2></div>
    <div class="subject-grid">
      <% course.subjects.forEach(function (s, i) { %>
        <div class="card subject reveal"><span><%= String(i + 1).padStart(2, '0') %></span><h3><%= s %></h3></div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="card try-band reveal">
      <div><h2>Vuoi prima provare?</h2><p>Fai 5 quiz gratuiti nel simulatore demo e scopri come funziona la correzione.</p></div>
      <a href="/simulatore" class="btn btn--primary btn--lg">Prova gratis</a>
    </div>
  </div>
</section>

<% if (related.length) { %>
<section class="section section--tint">
  <div class="container">
    <div class="section__head reveal"><span class="eyebrow">Potrebbero interessarti</span><h2>Altri concorsi <%= categoryLabel(course.category) %></h2></div>
    <div class="course-grid">
      <% related.forEach(function (c) { %><%- include('../partials/course-card', { c: c }) %><% }) %>
    </div>
  </div>
</section>
<% } %>
<%- include('../partials/footer') %>
