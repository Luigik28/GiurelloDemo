<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/page-hero', { eyebrow: 'Simulatore demo', heading: 'Mettiti alla prova <em>adesso</em>.', lead: 'Cinque quiz a risposta multipla, correzione immediata e spiegazione con il riferimento normativo. Come nei simulatori completi.' }) %>

<section class="section section--flush">
  <div class="container quiz-wrap">
    <div class="card quiz" data-quiz>
      <div class="quiz__start" data-quiz-start>
        <h2>Scegli la materia</h2>
        <div class="chips-row" data-quiz-subjects>
          <button type="button" class="chip chip--lg is-on" data-subject="">Tutte</button>
          <% subjects.forEach(function (s) { %><button type="button" class="chip chip--lg" data-subject="<%= s %>"><%= s %></button><% }) %>
        </div>
        <button type="button" class="btn btn--primary btn--lg" data-quiz-go>Inizia il quiz <%- include('../partials/icon', { name: 'arrow' }) %></button>
      </div>
      <div class="quiz__run" data-quiz-run hidden>
        <div class="quiz__meta"><span data-quiz-subject></span><span data-quiz-count></span></div>
        <div class="bar"><i data-quiz-bar></i></div>
        <h2 class="quiz__q" data-quiz-q></h2>
        <div class="quiz__opts" data-quiz-opts></div>
        <div class="quiz__fb" data-quiz-fb hidden></div>
        <button type="button" class="btn btn--primary" data-quiz-next hidden>Prossima domanda</button>
      </div>
      <div class="quiz__end" data-quiz-end hidden>
        <div class="score" data-quiz-score></div>
        <p class="lead" data-quiz-msg></p>
        <div class="hero__actions">
          <button type="button" class="btn btn--ghost" data-quiz-again>Rifai il quiz</button>
          <a href="/concorsi" class="btn btn--primary">Scegli il tuo simulatore</a>
        </div>
      </div>
    </div>
    <aside class="quiz-side">
      <div class="card info"><span class="icon-tile"><%- include('../partials/icon', { name: 'shield' }) %></span><h3>Correzione sul server</h3><p>Le risposte corrette non vengono mai inviate al browser: la verifica avviene sui nostri server.</p></div>
      <div class="card info"><span class="icon-tile"><%- include('../partials/icon', { name: 'book' }) %></span><h3>Spiegazioni</h3><p>Ogni risposta è accompagnata dal riferimento normativo per fissare il concetto.</p></div>
    </aside>
  </div>
</section>
<%- include('../partials/footer') %>
